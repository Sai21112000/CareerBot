{
  "mcpServers": {
    "careerbot": {
      "command": "uv",
      "args": [
        "run",
        "careerbot-mcp"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "CAREERBOT_EXECUTION_PROFILE": "dry_run",
        "CAREERBOT_MAX_JOBS_PER_RUN": "100",
        "CAREERBOT_MAX_APPLICATIONS_PER_RUN": "10",
        "CAREERBOT_MAX_RUN_MINUTES": "30"
      }
    }
  }
}
